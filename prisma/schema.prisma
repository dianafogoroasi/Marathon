generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                   String        @id @default(cuid())
  name                 String
  location             String
  raceDate             DateTime
  registrationDeadline DateTime?
  description          String?
  officialUrl          String?
  privateToken         String        @unique @default(uuid())
  createdAt            DateTime      @default(now())

  participants         Participant[]
}

model Participant {
  id            String  @id @default(cuid())
  eventId       String
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String
  email         String?
  phone         String?
  confirmed     Boolean @default(false)
  declined      Boolean @default(false)
  coupleLabel   String?

  raceType      String? // "maratona" | "mezza" | "supporto"

  departureDate String?
  returnDate    String?

  hasBib        Boolean @default(false)
  hasTransport  Boolean @default(false)
  transportType String? // "volo" | "treno"
  transportName String? // es. "Wizz Air", "Italo", "Freccia Rossa"

  hasHotel      Boolean @default(false)
  hotelName     String?
  hotelAddress  String?

  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
